# Copie para .env.local e preencha com os dados da aplicação SPA do Auth0
VITE_AUTH0_DOMAIN=dev-xxxxxxxx.us.auth0.com
VITE_AUTH0_CLIENT_ID=coloque-o-client-id-aqui
VITE_AUTH0_AUDIENCE=https://avaliacoes-api
VITE_AUTH0_CLAIMS_NAMESPACE=https://avaliacoes-api

# Opcional: URL base da API vista pelo navegador (padrão: /api, que usa o proxy)
# VITE_API_URL=/api
# Opcional: para onde o proxy do "npm run dev" encaminha /api
# API_PROXY_TARGET=http://localhost:8080
