  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ec2-44-197-175-105.compute-1.amazonaws.com:8080/:path*"
    }
  ]
}
